{
  "id": "cac",
  "name": "Cyberspace Administration of China",
  "short": "CAC",
  "class": "state",
  "cutoff": "2025-01-01",
  "hero": {
    "eyebrow": "State regulator persona",
    "title": "Who governs AI in China, and",
    "title_em": "CAC as a persona",
    "lede": "One actor from the party-state, built from its dated record: the orders it signed, the drafts that preceded them, and the campaigns and filing lists that followed."
  },
  "short_answer": [
    {
      "title": "Timing is predictable",
      "body": "Drafts become rules in a median of about six months; campaigns follow the calendar. Five timing reactions are patterns, each resting on four or more independent cases."
    },
    {
      "title": "Reactions to pressure are not, yet",
      "body": "Responses to firms or foreign governments rest on one or two episodes. They stay signals until new events test them."
    }
  ],
  "purpose": {
    "summary": "Writing policy, and responding to it, is fully in the control of people and the organisations they lead. So a persona built from an actor's record can forecast policy. It can't forecast events no actor controls.",
    "use_for": [
      "When a new AI technique reaches the public, when will CAC draft a rule, and with whom?",
      "How fast will CAC answer a domestic firm that moves without clearance, or a foreign restriction?",
      "After a rule takes effect, what enforcement follows, and who has to file?",
      "Which actors will move under a new CAC instrument, and how quickly?"
    ],
    "dont_use_for": [
      "Loss-of-control incidents, such as AI agents hacking into systems. No one is in control of those.",
      "Whether an incident happens at all. The persona speaks only to how CAC responds once one is public, and how long that takes."
    ]
  },
  "standing": {
    "class_role": "State · internet and information regulator. A Party commission's office and a state agency.",
    "principal": "The Central Cyberspace Affairs Commission, reportedly headed by Cai Qi since 2023 (coded from web sources; still needs a corpus source row). It reports to the Politburo and its Standing Committee.",
    "attribution_rule": "A row counts as CAC's when the body acted, not the person leading it: CAC, not Zhuang Rongwen.",
    "veto_players": "Every final AI rule before the cutoff was co-issued: 3 bodies for deep synthesis, 4 for algorithms, 7 for generative AI. Each co-issuer must agree, so each is a veto player (Tsebelis, 2002).",
    "gates_held": "Algorithm filing, generative-AI approval, data-export assessment, cybersecurity review. Filing works as a panopticon; approval and review work as chokepoints (Farrell & Newman, 2019).",
    "gates": [
      {
        "gate": "Generative-AI service approval",
        "held_by": "CAC",
        "over": "Every provider going public in China",
        "rows": [
          "O15"
        ],
        "response": "First 11 approvals in August 2023; batches since"
      },
      {
        "gate": "Algorithm filing",
        "held_by": "CAC",
        "over": "Recommendation and deep-synthesis providers",
        "rows": [
          "O9",
          "O12"
        ],
        "response": "Filing lists published about every two months"
      },
      {
        "gate": "Outbound data assessment",
        "held_by": "CAC",
        "over": "Firms sending data abroad",
        "rows": [
          "O11",
          "O13",
          "O16"
        ],
        "response": "Eased in 2024 with a new instrument, original left in place"
      },
      {
        "gate": "Cybersecurity review",
        "held_by": "CAC with 12 co-issuers",
        "over": "Platforms listing abroad; foreign suppliers",
        "rows": [
          "O8"
        ],
        "response": "Didi (2021), Micron (2023)"
      }
    ]
  },
  "powers": [
    {
      "id": "rule_making",
      "status": "holds",
      "use": "Dedicated rules for each new AI technique",
      "rows": [
        "O9",
        "O12",
        "O15"
      ],
      "limit": "Binding AI rules are co-issued with 2-6 other bodies"
    },
    {
      "id": "gatekeeping",
      "status": "holds",
      "use": "Approval before any generative-AI service goes public",
      "rows": [
        "O15"
      ],
      "limit": "Approval is batch by batch, with no published criteria in the record"
    },
    {
      "id": "information",
      "status": "holds",
      "use": "Algorithm filing and data-export assessment",
      "rows": [
        "O9",
        "O11"
      ],
      "limit": "What it learns is not public"
    },
    {
      "id": "sanctioning",
      "status": "holds",
      "use": "Fines, app removal, takedowns (Didi fined RMB 8.026 billion, 2022)",
      "rows": [
        "O14"
      ],
      "limit": "Criminal cases go to the Ministry of Public Security"
    },
    {
      "id": "review",
      "status": "holds",
      "use": "Cybersecurity review of platforms and suppliers",
      "rows": [
        "O8"
      ],
      "limit": "Used against a foreign firm once in the record (Micron)"
    },
    {
      "id": "mobilisation",
      "status": "holds",
      "use": "Time-boxed Qinglang and Clear campaigns that report takedown counts",
      "rows": [],
      "limit": "Campaign rows are not yet in this repo's log"
    },
    {
      "id": "external_coercion",
      "status": "partial",
      "use": "Only through reviews of foreign firms",
      "rows": [],
      "limit": "Export controls and sanctions sit with MOFCOM"
    },
    {
      "id": "fiscal",
      "status": "lacks",
      "use": "",
      "rows": [],
      "limit": "The persona should never predict CAC subsidising a firm"
    }
  ],
  "verbs_ruled_out": [
    "subsidise",
    "fund",
    "restrict_exports"
  ],
  "limits": [
    {
      "title": "Acted under it, not caused by it",
      "body": "Nearly every downstream line means an actor took a dated action under a CAC instrument. It shows reach and timing, not proof that CAC's act caused it."
    },
    {
      "title": "Built from the full cac.gov.cn log",
      "body": "289 acts: 23 official orders, 29 normative documents and 237 drafts, filing lists, enforcement notices and campaigns, as titled on cac.gov.cn (Chinese only). 7 further items issued by other bodies or standards committees are kept as context rows, not CAC acts."
    },
    {
      "title": "The vocabulary shapes what we can see",
      "body": "A firm launching right after CAC's approval is coded the same as an ordinary launch, so the gate disappears. Fix: keep the verb and add attributes (after_gate, gate_ref)."
    },
    {
      "title": "No baseline",
      "body": "Without one, a fit shows the persona is consistent with events, not that it forecasts better than a simpler guess."
    },
    {
      "title": "Version 1 tests, kept for the record",
      "body": "An earlier version had five rules (R1-R5) tested on events after the cutoff: R1 and R5 partly fit, R2-R4 had no qualifying trigger. They were rebuilt as C1-C4 and H1-H4 from the full act log, so those results no longer attach to a current reaction."
    }
  ],
